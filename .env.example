# Bitget demo-trading API key (created inside Demo mode -> Personal Center -> API Keys).
# Routed to the demo engine with the paptrading:1 header. Virtual funds, real fills.
BITGET_PAPER_API_KEY=
BITGET_PAPER_SECRET_KEY=
BITGET_PAPER_PASSPHRASE=

# Qwen, OpenAI-compatible endpoint. Falls back to rule classification when unset (cards say source: rules).
# BITGET_QWEN_API_KEY is the S2 handbook name and is preferred; QWEN_API_KEY is accepted as a legacy fallback.
BITGET_QWEN_API_KEY=
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
QWEN_MODEL=qwen3.8-max

# Keyed authorization between the mandate engine and execution boundary. Use 32+ random characters.
TESRUNE_MANDATE_SECRET=

# Live agentic-account execution via bgc. Off by default; demo engine is the proof venue.
TESRUNE_LIVE=0

# SEC EDGAR requires a descriptive User-Agent (name and contact).
EDGAR_USER_AGENT=Tesrune research desk contact@example.com

# Desk server
TESRUNE_PORT=4310

# Optional Telegram alerts (alert only, deep-links back to the desk to confirm).
# Create a bot with @BotFather, message it once, then set both values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public URL used in alert links; falls back to http://127.0.0.1:4310 when unset.
TESRUNE_PUBLIC_URL=
